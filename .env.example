# Complaint Radar environment.
#
# This build needs no secrets: all data comes from the deterministic mock
# adapter and the classifier is a keyword stub. These variables are declared
# so a real backend can be wired without touching component code.

# Base URL of the real backend that will replace the mock adapter.
# The HTTP adapter stub (src/data/adapters/http/client.ts) documents the
# endpoints it would call.
NEXT_PUBLIC_API_BASE_URL=""

# Demo-only flags. Leave empty in production; the demo controls (simulate
# spike, reset seed data) are removed when a real backend is connected.
NEXT_PUBLIC_DEMO_MODE="true"

# Data mode: "mock" or "supabase"
NEXT_PUBLIC_DATA_MODE="mock"

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Groq AI configuration
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-120b"

